    { "type": "NumberSpinner", "name": "UpdateInterval", "caption": "Intervall in Stunden", "minimum": 1, "maximum": 24 },
    { "type": "Label", "caption": "Die kostenlose API erlaubt bis zu 50 Abfragen pro Tag. Für eine Morgenprognose empfiehlt der Anbieter eine Abfrage 8–10 Stunden vorher." },
    { "type": "Button", "caption": "Jetzt aktualisieren", "onClick": "Eiswarnung_UpdateForecast($id);" }
  ],
